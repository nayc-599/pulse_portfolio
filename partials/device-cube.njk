{#- The Pulse device cube: a CSS 3D cube (six faces, preserve-3d) with the
    pixel face on the front lens, animated by js/device-cube.js (load that
    script on any page that includes this). Size with --cube-zoom on a parent;
    1 = the 200px cube used on the Project page. -#}
<div class="device-cube" aria-hidden="true" style="zoom:var(--cube-zoom,1);display:flex;align-items:center;justify-content:center;padding:28px 0;perspective:900px;perspective-origin:50% 45%">
  <div class="device-cube__cube" style="position:relative;width:200px;height:200px;transform-style:preserve-3d;transform:rotateX(-14deg) rotateY(-60deg)">
    <div style="position:absolute;inset:0;background:var(--cube-front);border:1px solid var(--rule-bone-16);transform:translateZ(100px);display:flex;align-items:center;justify-content:center">
      <div style="width:132px;height:132px;border-radius:50%;overflow:hidden;background:var(--charcoal);border:6px solid var(--cube-lens-bezel);display:flex;align-items:center;justify-content:center;box-shadow:inset 0 0 22px rgba(var(--black-rgb),0.6)">
        <div class="device-cube__face" style="display:grid;grid-template-columns:repeat(18,6px);grid-auto-rows:6px;gap:1px"></div>
      </div>
      <span style="position:absolute;top:16px;right:18px;width:16px;height:16px;border-radius:999px;background:var(--cube-button);border:3px solid var(--cube-button-ring)"></span>
    </div>
    <div style="position:absolute;inset:0;background:var(--cube-side);border:1px solid var(--rule-bone-16);transform:rotateY(90deg) translateZ(100px)"></div>
    <div style="position:absolute;inset:0;background:var(--cube-side);border:1px solid var(--rule-bone-16);transform:rotateY(-90deg) translateZ(100px)"></div>
    <div style="position:absolute;inset:0;background:var(--cube-top);border:1px solid var(--rule-bone-12);transform:rotateX(90deg) translateZ(100px)"></div>
    <div style="position:absolute;inset:0;background:var(--cube-bottom);border:1px solid var(--rule-bone-16);transform:rotateX(-90deg) translateZ(100px)"></div>
    <div style="position:absolute;inset:0;background:var(--cube-back);border:1px solid var(--rule-bone-16);transform:rotateY(180deg) translateZ(100px)"></div>
  </div>
</div>
