{#- One journal card, shared by the Journal page and the home page, in the
    original layout: thumbnail (or the pixel fallback) on the left, meta,
    title, excerpt and the byline (avatar, name, read time) in the text column.
    Build log posts and Updates use the same card. -#}
{% from "journal-thumb.njk" import journalThumb %}
{% from "byline.njk" import byline %}
{% macro journalCard(post, titleSize) %}
<li class="journal-entry rule-top--list" data-category="{{ post.data.category }}">
  <a href="{{ post.url }}" class="journal-entry__link hover-shift">
    {{ journalThumb(post, 7, 6, 2) }}
    <span style="display:flex;flex-direction:column;gap:9px;min-width:0">
      <span class="metadata is-plain">{{ post.data | postMeta }}</span>
      <span style="font:500 {{ titleSize }}px/1.28 var(--font-sans);letter-spacing:-0.015em">{{ post.data.title }}</span>
      <span style="font:400 15px/1.6 var(--font-sans);color:var(--ink-body);max-width:70ch">{{ post.data.summary or post.data.excerpt }}</span>
      <span class="journal-entry__byline">{{ byline(post.data, 24, post.data.readTime) }}</span>
    </span>
  </a>
</li>
{% endmacro %}
